    (:reset-manip-pose (&optional (limbs '(:rarm :larm)))
      "Predefined pose named reset-manip-pose."
      (unless (listp limbs) (setq limbs (list limbs)))
      (dolist (limb limbs)
        (case limb
          (:rarm (send self limb :angle-vector (float-vector -29.862000 22.570600 6.953630 -118.830000 69.818200 77.544100 82.076100)))
          (:larm (send self limb :angle-vector (float-vector 37.506000 23.111900 -15.275900 -119.030000 -67.951900 80.003400 7.131700)))
          (t (format t "Unknown limb is passed: ~a~%" limb))))
      (send self :angle-vector))
    (:reset-pose (&optional (limbs '(:rarm :larm)))
      "Predefined pose named reset-pose."
      (unless (listp limbs) (setq limbs (list limbs)))
      (dolist (limb limbs)
        (case limb
          (:rarm (send self limb :angle-vector (float-vector 0.000000 15.000000 0.000000 -135.000000 0.000000 150.000000 45.000000)))
          (:larm (send self limb :angle-vector (float-vector 0.000000 15.000000 0.000000 -135.000000 0.000000 150.000000 45.000000)))
          (t (format t "Unknown limb is passed: ~a~%" limb))))
      (send self :angle-vector))
