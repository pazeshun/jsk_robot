<launch>
  <arg name="bagfile_name" />
  <arg name="rosbag_option"  default="" />
  <arg name="robot" value="$(find panda_eus)/models/dual_panda.urdf.xacro" />
  <arg name="robot_id" default="dual_panda" />
  <arg name="RARM_VISION_RGB_IMAGE" default="/rarm_vision/camera/color/image_raw"/>
  <arg name="LARM_VISION_RGB_IMAGE" default="/larm_vision/camera/color/image_raw"/>
  <arg name="RIGHT_TAG_DETECTION_IMAGE" default="/right_tag_detections_image"/>
  <arg name="LEFT_TAG_DETECTION_IMAGE" default="/left_tag_detections_image"/>
  <arg name="RARM_CABLE_CONTOURS" default="/rarm_cable_terminal_detection/general_contours/image"/>
  <arg name="LARM_CABLE_CONTOURS" default="/larm_cable_terminal_detection/general_contours/image"/>
  <arg name="RARM_CABLE_HSV_COLOR_FILTER" default="/rarm_cable_terminal_detection/hsv_color_filter/image"/>
  <arg name="LARM_CABLE_HSV_COLOR_FILTER" default="/larm_cable_terminal_detection/hsv_color_filter/image"/>
  <arg name="" default="/rarm_cable_terminal_detection/hsv_color_filter/image"/>
  <param name="$(arg robot_id)/robot_description" command="xacro --inorder $(arg robot)" />

  <param name="/use_sim_time" value="true" />
  <node name="rosbag_play"
        pkg="rosbag" type="play"
        args="$(arg bagfile_name) --l --clock $(arg rosbag_option)">
  </node>

  <group ns="$(arg robot_id)">
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" output="screen"/>
  </group>

  <node name="rarm_vision_rgb_decompress" pkg="image_transport" type="republish"
	args="compressed in:=$(arg RARM_VISION_RGB_IMAGE) raw out:=$(arg RARM_VISION_RGB_IMAGE)" />
  <node name="larm_vision_rgb_decompress" pkg="image_transport" type="republish"
	args="compressed in:=$(arg LARM_VISION_RGB_IMAGE) raw out:=$(arg LARM_VISION_RGB_IMAGE)" />
  <node name="right_tag_detection_rgb_decompress" pkg="image_transport" type="republish"
	args="compressed in:=$(arg RIGHT_TAG_DETECTION_IMAGE) raw out:=$(arg RIGHT_TAG_DETECTION_IMAGE)" />
  <node name="left_tag_detection_rgb_decompress" pkg="image_transport" type="republish"
	args="compressed in:=$(arg LEFT_TAG_DETECTION_IMAGE) raw out:=$(arg LEFT_TAG_DETECTION_IMAGE)" />
  <node name="rarm_cable_contours_rgb_decompress" pkg="image_transport" type="republish"
	args="compressed in:=$(arg RARM_CABLE_CONTOURS) raw out:=$(arg RARM_CABLE_CONTOURS)" />
  <node name="larm_cable_terminal_contours_rgb_decompress" pkg="image_transport" type="republish"
	args="compressed in:=$(arg LARM_CABLE_CONTOURS) raw out:=$(arg LARM_CABLE_CONTOURS)" />
  <node name="rarm_cable_hsv_color_filter_rgb_decompress" pkg="image_transport" type="republish"
	args="compressed in:=$(arg RARM_CABLE_HSV_COLOR_FILTER) raw out:=$(arg RARM_CABLE_HSV_COLOR_FILTER)" />
  <node name="larm_cable_hsv_color_filter_rgb_decompress" pkg="image_transport" type="republish"
	args="compressed in:=$(arg LARM_CABLE_HSV_COLOR_FILTER) raw out:=$(arg LARM_CABLE_HSV_COLOR_FILTER)" />



  <node pkg="rviz" type="rviz" output="screen" name="rviz" args="-d $(find jsk_panda_startup)/config/rviz/dual_arm_with_realsense.rviz" />

</launch>
